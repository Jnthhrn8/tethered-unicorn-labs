{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "unicorn-forge-availability",
  "main": "worker.mjs",
  "account_id": "2cdc18dd668645ce861034681bcd2214",
  "compatibility_date": "2026-10-07",
